# Copy to .env and adjust. These configure the HARNESS (agentic_helper).
# LLM provider *secrets* (API keys) live separately in ~/.hermes/.env,
# which Hermes reads directly — you don't normally set keys here.

# Path to the Hermes Agent checkout (default: ~/hermes-agent)
HERMES_REPO=

# Model + provider. Blank inherits ~/.hermes/config.yaml (which the installer
# sets to the 'moonshot' custom provider). Set explicitly to override per-run.
# The Moonshot API key is NOT set here — Hermes pulls it from $MOONSHOT_API_KEY
# (configured via key_env in ~/.hermes/config.yaml). Put the key in ~/.hermes/.env.
HELPER_MODEL=kimi-k2-0905-preview
HELPER_PROVIDER=moonshot

# Toolset allowlist (comma-separated). Built-ins: web, file, terminal, memory,
# browser; composites: debugging (=file+terminal+web); or 'all' for everything.
# 'helper' is our custom plugin's toolset (save_note + list_dir).
HELPER_TOOLSETS=web,file,helper

# Optional tuning
HELPER_MAX_ITERATIONS=40
HELPER_SYSTEM_PROMPT=You are a concise, proactive daily-tasks helper.
HELPER_QUIET=true
